# Kopia ba .env no prense. JAMAIS commit .env.
# Jera SECRET_KEY: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=pdpada.example.com
CSRF_TRUSTED_ORIGINS=https://pdpada.example.com
# URL admin Django (troka husi default)
ADMIN_URL=admin-troka-ne/
SQLITE_PATH=/data/db.sqlite3
MEDIA_ROOT=/data/media
# Se atrás proxy (Railway/Nginx): hatama númeru proxy atu axes lee IP kliente loos
AXES_PROXY_COUNT=1
AXES_FAILURE_LIMIT=5
SECURE_SSL_REDIRECT=True
