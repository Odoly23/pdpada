# Kopia file ini jadi .env, lalu isi nilainya
DJANGO_SECRET_KEY=ganti-dengan-string-acak-panjang
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Produksi (PythonAnywhere): isi dengan https://USERNAME.pythonanywhere.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# sqlite (default) atau mysql
# Folder file privat (foto, kartu eleitoral). Kosong = <proyek>/private
DJANGO_PRIVATE_ROOT=
# HSTS (detik) setelah HTTPS stabil, mis. 31536000. 0 = mati
DJANGO_HSTS_SECONDS=0
# Folder log (produksi). Kosong = <proyek>/logs
DJANGO_LOG_DIR=
DB_ENGINE=sqlite
DB_NAME=pdpada
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
# Password awal user admin (dipakai perintah seed_inisial). Kosong = dibuat acak lalu ditampilkan.
ADMIN_PASSWORD=
